{
  "$schema": "https://typedoc.org/schema.json",
  "name": "SinterDB driver API",
  "entryPoints": ["../../packages/driver/dist/index.d.ts"],
  "tsconfig": "./tsconfig.json",
  "plugin": ["./react-output/index.js", "typedoc-plugin-markdown"],
  "outputs": [
    {
      "name": "html",
      "path": "../../docs/api/static"
    },
    {
      "name": "react",
      "path": "../../docs/api/react"
    },
    {
      "name": "markdown",
      "path": "../../docs/api/markdown"
    }
  ],
  "readme": "none",
  "reactOutput": {
    "framework": "next",
    "routeBase": "/docs/api",
    "cleanOutput": true,
    "assets": {
      "iconSprite": "/docs/api/assets/icons.svg"
    },
    "generated": {
      "directory": "_generated"
    },
    "components": {
      "directory": "_components"
    },
    "declarations": {
      "enabled": true,
      "directory": "_types",
      "moduleName": "@example/api-docs"
    },
    "features": {
      "hierarchy": true,
      "navigation": true,
      "pageNavigation": true,
      "sourceLinks": true,
      "comments": true
    },
    "theme": {
      "name": "default"
    }
  },
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "treatWarningsAsErrors": true,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "githubPages": false
}
