{
  "$schema": "./react-output/schema.json",
  "name": "SinterDB driver API",
  "entryPoints": ["../../packages/driver/dist/index.d.ts"],
  "tsconfig": "./tsconfig.json",
  "plugin": [
    "./react-output/index.js",
    "./react-output.js",
    "typedoc-plugin-markdown"
  ],
  "outputs": [
    {
      "name": "html",
      "path": "../../docs/api/static"
    },
    {
      "name": "reactOg",
      "path": "../../docs/api/reactOg"
    },
    {
      "name": "react",
      "path": "../../docs/api/react"
    },
    {
      "name": "markdown",
      "path": "../../docs/api/markdown"
    },
    {
      "name": "html",
      "path": "../../docs/examples/static"
    },
    {
      "name": "reactOg",
      "path": "../../docs/examples/reactOg"
    },
    {
      "name": "react",
      "path": "../../docs/examples/react"
    },
    {
      "name": "markdown",
      "path": "../../docs/examples/markdown"
    }
  ],
  "reactOutput": {
    "framework": "next",
    "routeBase": "/docs/api",
    "cleanOutput": true,
    "generated": {
      "directory": "_generated"
    },
    "components": {
      "directory": "_components"
    },
    "declarations": {
      "enabled": true,
      "directory": "_types",
      "moduleName": null
    },
    "features": {
      "hierarchy": true,
      "navigation": true,
      "pageNavigation": true,
      "sourceLinks": true,
      "comments": true,
      "externalInherited": false
    },
    "theme": {
      "name": "default",
      "colorScheme": "dark"
    }
  },
  "readme": "none",
  "maxTypeConversionDepth": 20,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "treatWarningsAsErrors": true,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "githubPages": false
}
