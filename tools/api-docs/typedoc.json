{
  "$schema": "https://typedoc.org/schema.json",
  "name": "SinterDB driver API",
  "entryPoints": ["../../packages/driver/dist/index.d.ts"],
  "tsconfig": "./tsconfig.json",
  "outputs": [
    {
      "name": "html",
      "path": "../../docs/api/static"
    },
    {
      "name": "react",
      "path": "../../docs/api/react"
    }
  ],
  "plugin": ["./react-output.js"],
  "readme": "none",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "treatWarningsAsErrors": true,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "githubPages": false
}
