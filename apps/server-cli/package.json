    "clean": "rimraf dist coverage"
  },
  "devDependencies": {
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Killer88967/sinterdb.git",
    "directory": "apps/server-cli"
  },
  "homepage": "https://github.com/Killer88967/sinterdb#readme",
  "bugs": {
    "url": "https://github.com/Killer88967/sinterdb/issues"
  },
  "keywords": [
    "sinterdb",
    "database",
    "document-database",
    "database-server",
    "cli"
  ]
