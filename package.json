{
  "name": "customdb-workspace",
  "version": "0.0.1",
  "private": true,
  "description": "A document-oriented database, its official Node.js driver, and supporting packages.",
  "author": "Killer88967",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "pnpm --recursive lint",
    "test": "pnpm --recursive test",
    "test:watch": "pnpm --recursive --parallel test:watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm --recursive clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  }
}
