{
  "name": "sinterdb-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "A document-oriented database, its official Node.js driver, and supporting packages.",
  "author": "Killer88967",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "all": "pnpm clean && pnpm build && pnpm api:check && pnpm docs:api && pnpm typecheck && pnpm format && pnpm lint && pnpm test && pnpm format:check",
    "build": "pnpm --recursive build",
    "api:check": "pnpm --recursive --if-present api:check",
    "api:update": "pnpm --recursive --if-present api:update",
    "docs:api": "pnpm --filter @sinterdb-internal/api-docs run generate",
    "bench": "pnpm --filter @sinterdb-internal/bench run bench",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "eslint .",
    "test": "pnpm build && pnpm --recursive test",
    "test:watch": "pnpm --recursive --parallel test:watch",
    "test:docker": "vitest packages/driver/src/docker.integration.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm --recursive run clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release:check": "node tools/release/src/check.ts",
    "release:rehearse": "node tools/release/src/rehearse.ts",
    "release:publish": "node tools/release/src/publish.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.4",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
