{
  "$schema": "https://unpkg.com/@changesets/config@3.1.2/schema.json",
  "changelog": "@changesets/cli/changelog",
  "commit": false,
  "fixed": [
    [
      "sinterdb",
      "sinterdb-protocol",
      "@sinterdb/cli",
      "@sinterdb-internal/server",
      "@sinterdb-internal/storage",
      "@sinterdb-internal/test-utils"
    ]
  ],
  "linked": [],
  "access": "public",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "bumpVersionsWithWorkspaceProtocolOnly": true,
  "ignore": [
    "@sinterdb-examples/todo-app",
    "@sinterdb-internal/api-docs",
    "@sinterdb-internal/bench",
    "@sinterdb-internal/release"
  ],
  "privatePackages": {
    "version": true,
    "tag": false
  }
}
