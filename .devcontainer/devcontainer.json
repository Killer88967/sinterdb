{
  "name": "SinterDB Website",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": true,
      "upgradePackages": true
    },
    "ghcr.io/devcontainers/features/node:2": {
      "version": "node",
      "nodeGypDependencies": true,
      "pnpmVersion": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/git-lfs:1": {}
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "FORCE_COLOR": "1",
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "SinterDB Website",
      "onAutoForward": "notify"
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": [
        "vscode-icons-team.vscode-icons",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "csstools.postcss",
        "yoavbls.pretty-ts-errors",
        "usernamehw.errorlens",
        "christian-kohler.path-intellisense",
        "christian-kohler.npm-intellisense",
        "mikestead.dotenv",
        "unifiedjs.vscode-mdx",
        "wayou.vscode-todo-highlight",
        "streetsidesoftware.code-spell-checker",
        "EditorConfig.EditorConfig",
        "GitHub.vscode-github-actions",
        "redhat.vscode-yaml",
        "eamodio.gitlens"
      ],
      "settings": {
        "workbench.colorTheme": "Dark Modern",
        "workbench.iconTheme": "vscode-icons",
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "editor.wordWrap": "on",
        "editor.linkedEditing": true,
        "editor.cursorBlinking": "phase",
        "editor.cursorSmoothCaretAnimation": "on",
        "editor.smoothScrolling": true,
        "editor.bracketPairColorization.enabled": true,
        "editor.guides.bracketPairs": true,
        "editor.guides.bracketPairsHorizontal": true,
        "editor.guides.highlightActiveBracketPair": true,
        "editor.inlayHints.enabled": "on",
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "on"
        },
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit",
          "source.organizeImports": "explicit"
        },
        "explorer.compactFolders": false,
        "explorer.confirmDelete": false,
        "explorer.confirmDragAndDrop": false,
        "files.encoding": "utf8",
        "files.eol": "\n",
        "files.insertFinalNewline": true,
        "files.trimFinalNewlines": true,
        "files.trimTrailingWhitespace": true,
        "files.associations": {
          "devcontainer.json": "jsonc",
          "*.code-workspace": "jsonc",
          "*.css": "tailwindcss"
        },
        "files.exclude": {
          "**/.next": true,
          "**/.turbo": true
        },
        "files.watcherExclude": {
          "**/.next/**": true,
          "**/.turbo/**": true,
          "**/node_modules/**": true
        },
        "search.exclude": {
          "**/.next": true,
          "**/.turbo": true,
          "**/node_modules": true,
          "**/pnpm-lock.yaml": true
        },
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.scrollback": 10000,
        "git.autofetch": true,
        "git.confirmSync": false,
        "git.enableSmartCommit": true,
        "git.openRepositoryInParentFolders": "always",
        "eslint.validate": [
          "javascript",
          "javascriptreact",
          "typescript",
          "typescriptreact"
        ],
        "eslint.format.enable": true,
        "js/ts.tsdk.path": "node_modules/typescript/lib",
        "js/ts.updateImportsOnFileMove.enabled": "always",
        "js/ts.updateImportsOnPaste.enabled": true,
        "js/ts.preferences.importModuleSpecifier": "non-relative",
        "js/ts.preferences.importModuleSpecifierEnding": "minimal",
        "js/ts.preferences.includePackageJsonAutoImports": "auto",
        "js/ts.preferences.preferTypeOnlyAutoImports": true,
        "js/ts.preferences.renameMatchingJsxTags": true,
        "js/ts.autoClosingTags.enabled": true,
        "tailwindCSS.emmetCompletions": true,
        "emmet.includeLanguages": {
          "javascript": "javascriptreact",
          "typescript": "typescriptreact"
        },
        "license.author": "Killer88967",
        "license.default": "apache-2.0",
        "chat.mcp.enabled": true,
        "chat.mcp.discovery.enabled": {
          "claude-desktop": false,
          "copilot": false,
          "windsurf": false,
          "cursor-global": false,
          "cursor-workspace": false
        },
        "chat.mcp.gallery.enabled": true,
        "chat.mcp.access": "all",
        "github.copilot.enable": {
          "*": false,
          "plaintext": false,
          "markdown": false,
          "scminput": false
        },
        "[javascript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[javascriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[typescriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[css]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[scss]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[html]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[jsonc]": {
          "editor.defaultFormatter": "vscode.json-language-features"
        },
        "[yaml]": {
          "editor.defaultFormatter": "redhat.vscode-yaml"
        },
        "[github-actions-workflow]": {
          "editor.defaultFormatter": "redhat.vscode-yaml"
        },
        "[markdown]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "files.trimTrailingWhitespace": false
        },
        "[mdx]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "files.trimTrailingWhitespace": false
        }
      }
    }
  }
}
